# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to enable demo mode:
#   - Skips authentication (no login required)
#   - Shows placeholder data for unauthenticated visitors
# Set to "false" (or leave unset) for production with real auth.
NEXT_PUBLIC_DEMO_MODE=false

# ── API URL (optional) ────────────────────────────────────────────────────────
# Only needed if the frontend is served from a different origin than the backend.
# In Docker Compose the nginx reverse proxy handles routing — leave this unset.
# NEXT_PUBLIC_API_URL=https://yourdomain.com
