# ── Service URLs ─────────────────────────────────────────────────────────────
# In Docker Compose: use the service names.  In production: use real URLs.
DOMAIN=http://localhost:8000
FRONTEND_DOMAIN=http://localhost:5000

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/callback/github  (dev)
#                             https://yourdomain.com/callback/github  (prod)
OAUTH_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── Google OAuth App ──────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs: http://localhost:5000/callback/google  (dev)
#                           https://yourdomain.com/callback/google  (prod)
OAUTH_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get credentials at https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── JWT / Session ─────────────────────────────────────────────────────────────
# JWT_SECRET must match the value in agent-service/.env exactly.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_strong_random_secret_min_32_chars
SESSION_SECRET=change_me_to_another_strong_random_secret_min_32_chars

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Fireworks AI (optional — only needed if backend calls LLMs directly) ──────
FireworksAPIKey=fw_your_fireworks_api_key_here
