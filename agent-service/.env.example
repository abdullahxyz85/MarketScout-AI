# ── Fireworks AI (AMD Instinct GPUs) ────────────────────────────────────────
# Required. Get your key at https://fireworks.ai
FIREWORKS_API_KEY=fw_your_fireworks_api_key_here

# ── Tavily Web Search ────────────────────────────────────────────────────────
# Optional in dev (ALLOW_MOCK_SEARCH=true enables built-in mock results).
# Required in production (AGENT_AUTH_ENABLED=true will fail at startup without it).
# Get your key at https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Supabase (persistent research memory — optional) ─────────────────────────
# Leave empty to run without persistence (results stored in memory only).
# Get credentials at https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Authentication ────────────────────────────────────────────────────────────
# Must match the JWT_SECRET in backend/.env exactly (shared secret).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_strong_random_secret_min_32_chars

# Set to true in production to enforce JWT validation on all sensitive routes.
# false = dev/demo mode: auth guard is bypassed so the service works without
#          a running backend — useful for local development and hackathon demos.
AGENT_AUTH_ENABLED=false

# Set to false in production — startup will fail if TAVILY_API_KEY is absent
# and this is false. true = use built-in mock results when key is missing.
ALLOW_MOCK_SEARCH=true
